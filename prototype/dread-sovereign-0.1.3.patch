+    private static void enforceEncounterAllianceState(ServerLevel level, Encounter encounter,
+                                                     @Nullable LivingEntity queen,
+                                                     @Nullable LivingEntity dragon) {
+        ServerPlayer playerTarget = nearestCombatPlayer(level, encounter.center, PLAYER_SEARCH_RANGE);
+
+        if (queen != null) {
+            clearFrozenState(queen);
+            if (queen instanceof Mob queenMob
+                    && (queenMob.getTarget() == null
+                    || isEncounterAlly(queenMob.getTarget(), encounter))) {
+                queenMob.setTarget(playerTarget);
+            }
+        }
+
+        if (dragon != null) {
+            clearFrozenState(dragon);
+            if (dragon instanceof Mob dragonMob
+                    && (dragonMob.getTarget() == null
+                    || isEncounterAlly(dragonMob.getTarget(), encounter))) {
+                dragonMob.setTarget(playerTarget);
+            }
+        }
+
+        for (UUID minionId : encounter.minionIds) {
+            Entity entity = level.getEntity(minionId);
+            if (!(entity instanceof LivingEntity living)) {
+                continue;
+            }
+            clearFrozenState(living);
+            if (living instanceof Mob minion
+                    && (minion.getTarget() == null
+                    || isEncounterAlly(minion.getTarget(), encounter))) {
+                minion.setTarget(playerTarget);
+            }
+        }
+    }
+
+    private static void clearFrozenState(LivingEntity entity) {
+        if (entity.getTicksFrozen() > 0) {
+            entity.setTicksFrozen(0);
+        }
+    }
